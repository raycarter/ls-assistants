# Azure resource endpoint; /openai/v1/ is appended automatically.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com

# Azure deployment names, in display order. Whitespace/duplicates are removed.
AVAILABLE_MODELS=your-primary-deployment,your-secondary-deployment
# Omit or leave blank to select the first deployment.
DEFAULT_MODEL=

# Set all three for a service principal, or leave all three blank for Azure CLI.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

REQUEST_TIMEOUT_SECONDS=120
PROVIDER_TIMEOUT_SECONDS=60
TITLE_TIMEOUT_SECONDS=10
MAX_OUTPUT_TOKENS=4096
MAX_RETRIES=2
RETRY_DELAY_SECONDS=0.5
